{
  "name": "stellplatz-sharing",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-Source-Web-App zum Teilen von Tiefgaragenstellplätzen in einer Wohnanlage",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:totp": "tsx scripts/totp.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "plan:build": "tsx scripts/drawio-plan.ts",
    "i18n:check": "node scripts/i18n-keys.mjs --check",
    "test:docker": "docker compose -f compose.test.yml up --build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.3",
    "fast-xml-parser": "5.11.2",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.2",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "stripe": "18.5.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "3.6.4",
    "postcss": "8.5.30",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2"
  }
}
