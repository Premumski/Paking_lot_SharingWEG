# Copy to .env and fill in. Never commit .env (O-06).

# --- Domain / TLS ---
DOMAIN=parken.example.org
ACME_EMAIL=admin@example.org

# --- Database ---
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=parking

# --- App ---
# openssl rand -hex 32
SESSION_SECRET=change-me
# Leave DEV_TOOLS=false in production!
DEV_TOOLS=false
# Check new passwords against haveibeenpwned (k-anonymity, only 5 hash characters leave the server)
HIBP_ENABLED=true

# --- Payments (Z-01) ---
# mock = simulated payments for tests, stripe = Stripe Connect
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
# Webhook endpoint https://<DOMAIN>/api/webhooks/stripe, type "Connect" (events on connected accounts):
# checkout.session.completed, payment_intent.processing, payment_intent.succeeded,
# payment_intent.payment_failed, charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=whsec_...

# --- E-mail (O-08: provider with SPF, DKIM, DMARC for your domain) ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.org
SMTP_PASSWORD=change-me
MAIL_FROM="Stellplatz-Sharing <noreply@example.org>"

# --- Web push (N-01): npm run gen:vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
